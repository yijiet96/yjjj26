# 複製本檔為 .env 後填入你的金鑰;.env 已被 .gitignore 忽略,不會外洩
# 全部都是「選用」:留空也能跑(demo 模式 + 規則式分析),填越多功能越完整。

# ---- 市場資料 -------------------------------------------------------------
# 台股(FinMind);免費有額度限制,建議註冊取得 token 提高額度:https://finmindtrade.com
FINMIND_TOKEN=
# 美股財報(選用,FMP);價量用 yfinance 免費、免金鑰
FMP_API_KEY=

# ---- LLM 新聞/社群分析(擇一即可;皆空則用規則式關鍵詞分析)----------------
# 注意:Claude/Gemini 的「網頁訂閱」非 API 金鑰,無法被自動程式呼叫,需到 console 申請 API key。
ANTHROPIC_API_KEY=          # https://console.anthropic.com
GEMINI_API_KEY=             # https://aistudio.google.com/apikey(有免費額度,適合每月 ~$10 預算)
# 可選:覆寫預設模型
# CLAUDE_MODEL=claude-opus-4-8
# GEMINI_MODEL=gemini-2.5-flash

# ---- 社群貼文來源(選用,皆空則用 demo 範例)-------------------------------
NITTER_INSTANCE=            # 例:https://nitter.net(免費但實例常不穩)
X_BEARER_TOKEN=             # 選用:X/Twitter API(最完整,需自備)
# 或:把想分析的貼文手動貼進 data/raw/social_posts.json
#    格式:[{"handle":"elonmusk","text":"...","published":"2026-06-11"}]

# ---- 每日簡報寄送(選用,皆空則只存檔到 reports/)--------------------------
SMTP_HOST=                  # 例:smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                  # 你的寄件信箱
SMTP_PASS=                  # Gmail 請用「應用程式密碼」App Password,非登入密碼
REPORT_TO=                  # 收件信箱(可逗號分隔多個)
